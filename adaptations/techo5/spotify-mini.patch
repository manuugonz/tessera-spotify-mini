@@ -0,0 +1,72 @@
+//go:build !dot && !spot
+
+package display
+
+import (
+	"encoding/json"
+	"image"
+	"image/png"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/HuskerMinion/techo5/echod/internal/config"
+	"github.com/HuskerMinion/techo5/echod/internal/feature/tessera"
+)
+
+// The actual receiver converts a Store plugin message, then the Show 8 renderer
+// draws it and emits its native media control hit zones. No physical hardware.
+func TestSpotifyMiniShow8Render(t *testing.T) {
+	config.Use(filepath.Join(t.TempDir(), "state.json"))
+	if err := config.Set().Dashboard().Mode(config.DashboardTessera); err != nil {
+		t.Fatal(err)
+	}
+	rcv := tessera.NewReceiver(tessera.Capabilities{MaxTiles: 8, MaxPages: 8}, nil)
+	hello := rcv.Receive(`{"v":2,"op":"hello"}`)
+	seq := 0
+	send := func(m map[string]any) {
+		seq++
+		m["v"] = 2
+		m["seq"] = seq
+		m["session"] = hello.Session
+		m["rev"] = "spotify-mini-test"
+		b, _ := json.Marshal(m)
+		a := rcv.Receive(string(b))
+		if a.Status != tessera.StatusLoading && a.Status != tessera.StatusSynced {
+			t.Fatal(a.Status)
+		}
+	}
+	send(map[string]any{"op": "begin", "pages": 1, "tiles": 1, "home": 0})
+	send(map[string]any{"op": "page", "p": 0, "title": "Spotify Mini", "items": []any{}})
+	send(map[string]any{"op": "tile", "i": 0, "slot": 0, "entity": "plugin:spotify_mini.player", "name": "Spotify Mini", "state": "ok",
+		"o": map[string]any{"size": "square", "pe": "media_player.spotify_mini"},
+		"x": map[string]any{"state": "playing", "attributes": map[string]any{"media_title": "Evening Walk", "media_artist": "Example Ensemble", "volume_level": 0.35}}})
+	send(map[string]any{"op": "commit"})
+	tessera.Preview(rcv.Layout(), 4, 3)
+	t.Cleanup(func() { tessera.Preview(nil, 0, 0) })
+	img := image.NewRGBA(image.Rect(0, 0, 1280, 800))
+	r := newRenderer(img)
+	v, on := tessera.Current()
+	r.draw(scene{now: time.Now(), phase: "idle", showDash: true, dashMode: config.DashboardTessera, tessera: v, tessOn: on})
+	zones, _ := r.dash()
+	found := false
+	for _, z := range zones {
+		if z.entity == "media_player.spotify_mini" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("no media touch zone in Show 8 renderer")
+	}
+	if dest := os.Getenv("SPOTIFY_MINI_RENDER"); dest != "" {
+		f, err := os.Create(dest)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer f.Close()
+		if err := png.Encode(f, img); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
