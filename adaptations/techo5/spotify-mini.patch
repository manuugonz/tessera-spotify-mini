diff --git a/echod/internal/feature/tessera/spotify_mini.go b/echod/internal/feature/tessera/spotify_mini.go
new file mode 100644
index 0000000..afdc812
--- /dev/null
+++ b/echod/internal/feature/tessera/spotify_mini.go
@@ -0,0 +1,70 @@
+package tessera
+
+import (
+	"encoding/json"
+	"strings"
+)
+
+// NativePlugin advertises a built-in wire adapter. It does not load C++ or LVGL.
+// Only Spotify Mini 0.1.0's player contract is implemented, not arbitrary plugins.
+type NativePlugin struct {
+	ID      string   `json:"id"`
+	Version string   `json:"version"`
+	Tiles   []string `json:"tiles"`
+}
+
+const spotifyMiniTile = "plugin:spotify_mini.player"
+
+func supportedSpotifyTile(t Tile) bool {
+	return !strings.HasPrefix(t.Entity, "plugin:") || t.Entity == spotifyMiniTile
+}
+
+// spotifyNativeTile maps the Store plugin's bounded wire state onto the existing
+// TECHO5 media renderer. Its name and placement survive; no firmware code is fetched.
+func spotifyNativeTile(t Tile) Tile {
+	if t.Entity != spotifyMiniTile {
+		return t
+	}
+	var options map[string]any
+	if json.Unmarshal(t.O, &options) != nil {
+		return t
+	}
+	entity, _ := options["pe"].(string)
+	if !validMiniEntity(entity) {
+		return t
+	}
+	var data struct {
+		State      string         `json:"state"`
+		Attributes map[string]any `json:"attributes"`
+	}
+	if json.Unmarshal(t.X, &data) != nil {
+		return t
+	}
+	if data.Attributes == nil {
+		data.Attributes = map[string]any{}
+	}
+	// Keep the native playback controls and media detail sheet.
+	options["controls"] = "playback"
+	options["tap"] = "detail"
+	options["spotify_mini"] = true
+	if data.State == "" {
+		data.State = "unavailable"
+	}
+	t.Entity, t.State = entity, data.State
+	t.A, _ = json.Marshal(data.Attributes)
+	t.O, _ = json.Marshal(options)
+	t.X = nil
+	return t
+}
+
+func validMiniEntity(entity string) bool {
+	if !strings.HasPrefix(entity, "media_player.") || len(entity) <= len("media_player.") || len(entity) > 255 {
+		return false
+	}
+	for _, c := range strings.TrimPrefix(entity, "media_player.") {
+		if c != '_' && (c < 'a' || c > 'z') && (c < '0' || c > '9') {
+			return false
+		}
+	}
+	return true
+}
diff --git a/echod/internal/feature/tessera/spotify_mini_test.go b/echod/internal/feature/tessera/spotify_mini_test.go
new file mode 100644
index 0000000..def0b3f
--- /dev/null
+++ b/echod/internal/feature/tessera/spotify_mini_test.go
@@ -0,0 +1,89 @@
+package tessera
+
+import (
+	"encoding/json"
+	"slices"
+	"testing"
+	"time"
+
+	"github.com/HuskerMinion/techo5/echod/internal/component"
+)
+
+func miniTile() Tile {
+	slot := 0
+	return Tile{I: 0, Slot: &slot, Entity: spotifyMiniTile, Name: "Spotify Mini", State: "ok",
+		O: json.RawMessage(`{"size":"square","pe":"media_player.spotify_mini"}`),
+		X: json.RawMessage(`{"state":"playing","attributes":{"media_title":"Evening Walk","media_artist":"Example","volume_level":0.4}}`)}
+}
+
+func TestSpotifyMiniAdapter(t *testing.T) {
+	c := capabilities(gridFor(true, false))
+	if !slices.Contains(c.Features, "plugins") {
+		t.Fatal("plugin delivery disabled")
+	}
+	a := NewReceiver(c, nil).Receive(`{"v":2,"op":"hello"}`)
+	if a.PluginAPI != "0.13" || len(a.Plugins) != 1 || a.Plugins[0].ID != "spotify_mini" {
+		t.Fatalf("bad hello: %+v", a)
+	}
+	tile := spotifyNativeTile(miniTile())
+	p := describe(tile, tileOptions(tile))
+	if p.Entity != "media_player.spotify_mini" || p.State != "playing" || !p.Detail || !p.Taps {
+		t.Fatalf("bad tile: %+v", p)
+	}
+	if len(p.Controls) != 1 || p.Controls[0] != "playback" {
+		t.Fatalf("missing playback: %+v", p.Controls)
+	}
+	if !stringsContains(p.Value, "Evening Walk") {
+		t.Fatalf("metadata lost: %s", p.Value)
+	}
+}
+func stringsContains(s, sub string) bool {
+	for i := 0; i+len(sub) <= len(s); i++ {
+		if s[i:i+len(sub)] == sub {
+			return true
+		}
+	}
+	return false
+}
+
+func TestSpotifyMiniRejectsOtherPluginsAndBadTargets(t *testing.T) {
+	tile := miniTile()
+	tile.Entity = "plugin:other.any"
+	if supportedSpotifyTile(tile) {
+		t.Fatal("claimed arbitrary plugin support")
+	}
+	tile = miniTile()
+	tile.O = json.RawMessage(`{"pe":"light.kitchen"}`)
+	if spotifyNativeTile(tile).Entity != spotifyMiniTile {
+		t.Fatal("cross-domain target")
+	}
+	for _, entity := range []string{"media_player.", "media_player.x,light.y", "media_player.{{x}}"} {
+		if validMiniEntity(entity) {
+			t.Fatal(entity)
+		}
+	}
+}
+
+func TestSpotifyMiniStateAndTouch(t *testing.T) {
+	tile := spotifyNativeTile(miniTile())
+	r := NewReceiver(capabilities(gridFor(true, false)), nil)
+	r.Restore(&Layout{Rev: rev1, Begin: Begin{Pages: 1, Tiles: 1}, Pages: []Page{{P: 0}}, Tiles: []Tile{tile}})
+	screen := newScreen(r, gridFor(true, false))
+	if !screen.Tap(0, tile.Entity, time.Now()) {
+		t.Fatal("touch must open native media sheet")
+	}
+	// A state update arrives under the plugin's identity, not the converted entity.
+	if r.state([]byte(`{"i":0,"entity":"plugin:spotify_mini.player","state":"ok","x":{"state":"paused","attributes":{"media_title":"Next"}}}`)) != StatusSynced {
+		t.Fatal("update refused")
+	}
+	if r.active.Tiles[0].Entity != tile.Entity || r.active.Tiles[0].State != "paused" {
+		t.Fatal("state update lost target")
+	}
+	var got component.Call
+	remove := component.CallService.Listen(func(c component.Call) { got = c })
+	defer remove()
+	Call(tile.Entity, "media_player.media_next_track", nil)
+	if got.Service != "media_player.media_next_track" || got.Data["entity_id"] != tile.Entity {
+		t.Fatalf("bad control %+v", got)
+	}
+}
